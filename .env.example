# PromptShield configuration. Copy to .env (never commit .env).

# --- PostgreSQL (required) -------------------------------------------------
# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://promptshield:change-me@localhost:5432/promptshield
# Optional: separate database for the integration tests (tables go in a throwaway schema)
TEST_DATABASE_URL=

# --- Gemini (backend only; never expose to the frontend) -------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried once when GEMINI_MODEL is overloaded (503), rate-limited (429) or times out (504)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# --- ML detector -------------------------------------------------------------
# Leave empty to use ml_detector/models/production_model.json.
# Or one of: logistic_regression, linear_svm, random_forest
PROMPTSHIELD_CLASSIFIER=

# --- FLAG review workflow ----------------------------------------------------
# Required to use /api/review/* (send as the X-Admin-Key header). Use a long random value.
ADMIN_API_KEY=

# --- API ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_HISTORY_TURNS=10
MAX_PROMPT_LENGTH=4096
